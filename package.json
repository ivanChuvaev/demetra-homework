{
  "name": "demetra-homework",
  "version": "0.0.1",
  "description": "Demetra homework by Chuvaev Ivan",
  "author": "Chuvaev Ivan",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:integration": "vitest run --config ./vitest.config.integration.ts --no-file-parallelism",
    "migration:create": "node ./scripts/migration-create.js",
    "migration:generate": "node ./scripts/migration-generate.js",
    "migration:run": "typeorm-ts-node-esm migration:run -d ./datasource.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d ./datasource.ts",
    "migration:show": "typeorm-ts-node-esm migration:show -d ./datasource.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.1",
    "@scalar/nestjs-api-reference": "^1.2.23",
    "@types/pg": "^8.23.1",
    "bcrypt": "^6.0.0",
    "dotenv-expand": "^1000.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
